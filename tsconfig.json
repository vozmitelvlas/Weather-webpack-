{
  "compilerOptions": {
    "target": "es2024",
    "module": "commonjs",
    "allowJs": true, 
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.ts", "node_modules", "dist"]
}